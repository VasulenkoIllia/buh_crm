// buh_crm — ER schema v1 (S0). All entities up front; modules land stage by stage.
// Conventions: uuid PKs, createdAt/updatedAt, currency = USD integer minor units (cents),
// soft delete via archivedAt/archivedBy on archivables, derived values never stored.

generator client {
  provider = "prisma-client"
  output   = "../server/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  admin
  user
}

enum UserStatus {
  invited
  pending
  active
  blocked
}

enum AuthTokenType {
  invite
  email_confirm
  password_reset
}

enum ServiceType {
  subscription
  one_time
  internal
}

enum InvoiceTrigger {
  on_create
  on_complete
  on_period_start
  on_period_end
}

enum BillingPeriod {
  month
  quarter
  year
}

enum Periodicity {
  weekly
  monthly
  quarterly
  yearly
  once
}

enum TaskKind {
  once // one-off billable
  sub  // generated from subscription
  free // internal, non-billable
}

enum LeadStage {
  first_contact
  no_answer
  set_up_meeting
  thinking
  on_hold
  next_time
}

enum LeadOutcome {
  in_process
  won
  lost
}

enum PaymentAuditAction {
  created
  updated
  deleted
}

enum NotificationKind {
  task
  meeting
  invoice
  system
}

enum CampaignAudience {
  all
  by_service
  by_debt
  manual
}

enum CampaignSchedule {
  one_off
  recurring
}

// ── Users & auth ─────────────────────────────────────────────────────────────

model User {
  id               String     @id @default(uuid()) @db.Uuid
  firstName        String
  lastName         String
  email            String     @unique
  passwordHash     String?
  role             UserRole   @default(user)
  status           UserStatus @default(invited)
  avatarFileId     String?    @unique @db.Uuid
  emailConfirmedAt DateTime?
  invitedAt        DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  avatarFile          File?                @relation("UserAvatar", fields: [avatarFileId], references: [id])
  authTokens          AuthToken[]
  sessions            Session[]
  taskAssignments     TaskAssignee[]
  tasksCreated        Task[]               @relation("TaskCreatedBy")
  taskComments        TaskComment[]        @relation("TaskCommentAuthor")
  timeEntries         TimeEntry[]
  timeEntriesCreated  TimeEntry[]          @relation("TimeEntryCreatedBy")
  meetingParticipants MeetingParticipant[]
  notifications       Notification[]
  paymentsCreated     Payment[]            @relation("PaymentCreatedBy")
  paymentAuditLogs    PaymentAuditLog[]
  invoicesCreated     Invoice[]            @relation("InvoiceCreatedBy")
  invoicesSent        Invoice[]            @relation("InvoiceSentBy")
  invoicesCancelled   Invoice[]            @relation("InvoiceCancelledBy")
  invoicesArchived    Invoice[]            @relation("InvoiceArchivedBy")
  uploadedFiles       File[]               @relation("FileUploadedBy")
}

model AuthToken {
  id        String        @id @default(uuid()) @db.Uuid
  userId    String        @db.Uuid
  type      AuthTokenType
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

model Session {
  id        String   @id // session id from the cookie
  userId    String   @db.Uuid
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ── Settings ─────────────────────────────────────────────────────────────────

model Priority {
  id        String  @id @default(uuid()) @db.Uuid
  name      String  @unique
  color     String
  order     Int
  isDefault Boolean @default(false)

  tasks Task[]
}

model SourceOption {
  id     String  @id @default(uuid()) @db.Uuid
  name   String  @unique
  order  Int
  active Boolean @default(true)

  clients Client[]
  leads   Lead[]
}

model FirmProfile {
  id                   Int     @id @default(1) // singleton row
  name                 String
  logoFileId           String? @unique @db.Uuid
  // invoice numbering (decision 2026-07-17): PREFIX-YEAR-NNNN, yearly counter reset
  invoicePrefix        String  @default("INV")
  invoiceCounterDigits Int     @default(4)
  // allocated counter (S7): the last number handed out for `invoiceCounterYear`. Bumped inside a
  // transaction so concurrent issues never collide; resets when the firm year rolls over.
  invoiceCounterYear   Int?
  invoiceCounter       Int     @default(0)
  currency             String  @default("USD")

  logoFile File? @relation(fields: [logoFileId], references: [id])
}

// ── Catalog ──────────────────────────────────────────────────────────────────

model Service {
  id             String         @id @default(uuid()) @db.Uuid
  name           String         @unique // is the category label
  color          String
  type           ServiceType
  defaultAmount  Int? // minor units — expected price; per-client override on Subscription.amount
  invoiceTrigger InvoiceTrigger @default(on_create)
  invoiceDay     Int? // "on day N of the period" (design: billing rule sub-panel)
  dueDays        Int? // invoice counts as overdue N days after issue; null = never
  active         Boolean        @default(true)
  // at most ONE service (one-time only) is auto-added to every new client — enforced by the
  // partial unique index `Service_single_default_for_new_clients` (raw SQL, not expressible here)
  autoAddToNewClients Boolean   @default(false)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  taskTemplates    TaskTemplate[]
  subscriptions    Subscription[]
  clientCategories ClientServiceCategory[]
  tasks            Task[]
  leads            Lead[]
  invoices         Invoice[]
  meetings         Meeting[]
  people           ClientPerson[]
}

model TaskTemplate {
  id                 String      @id @default(uuid()) @db.Uuid
  serviceId          String      @db.Uuid
  name               String
  periodicity        Periodicity
  dayOfPeriod        Int? // weekly: 1-7 (Mon=1); monthly/quarterly/yearly: 1-31 or -1 = last day
  monthOfPeriod      Int? // quarterly: 1-3 (month of quarter); yearly: 1-12
  deadlineOffsetDays Int? // deadline = createdAt + offset; null = no deadline
  estimatedMinutes   Int? // planned labor default; per-task override via Task.plannedMinutes
  defaultChecklist   Json? // string[] of default checklist steps → seeded onto generated/created tasks
  description        String? // seeded into the generated task's description
  defaultAssigneeIds Json? // uuid[] of default assignees → seeded onto generated tasks
  billable           Boolean     @default(true)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@index([serviceId])
}

// ── Clients ──────────────────────────────────────────────────────────────────

// Client model rework 2026-07-26 (supersedes the 2026-07-18 "one entity with a type" reset):
// a client is just a client — no individual/company discriminator. `companyName` survives as a
// plain informational label; the COMPANIES a client holds are real rows below.
model Client {
  id              String    @id @default(uuid()) @db.Uuid
  firstName       String // the client's identity — required; lastName is optional
  lastName        String?
  companyName     String? // informational only ("works at / trades as"), never an identity
  phone           String?
  email           String?
  address         String?
  sourceId        String?   @db.Uuid
  description     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  archivedAt      DateTime?
  archivedById    String?   @db.Uuid

  source        SourceOption?           @relation(fields: [sourceId], references: [id])
  companies     Company[] // 1:N — the client's companies (see below)
  people        ClientPerson[] // the "People" tab
  categories    ClientServiceCategory[]
  subscriptions Subscription[]
  tasks         Task[]
  invoices      Invoice[]
  meetings      Meeting[]
  reminders     Reminder[]
  files         File[]                  @relation("ClientFiles")
  convertedLead Lead?                   @relation("LeadConvertedClient")

  @@index([archivedAt])
}

/// A company OWNED BY ONE CLIENT (2026-07-26) — the invoicing / task / report dimension that
/// `companyId` points at. A client may hold many; a company belongs to exactly one.
/// `companyId = null` anywhere else means "the client directly, no company" — which is the
/// normal case for a client that holds none.
/// `name` is unique across the WHOLE system, case-insensitively: the unique index lives in raw
/// SQL (`Company_name_key_ci` on lower(name)) because Prisma can't express a functional index —
/// see server/schema-invariants.test.ts, which guards it.
model Company {
  id       String  @id @default(uuid()) @db.Uuid
  clientId String  @db.Uuid
  name     String
  // optional contact details — `email` is where this company's invoices will be sent (S10);
  // with none set the client's own email is the fallback
  phone       String?
  email       String?
  description String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  client        Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  subscriptions Subscription[]
  invoices      Invoice[]
  tasks         Task[]

  @@index([clientId])
}

// The "People" tab — people involved with a client + the service they handle.
model ClientPerson {
  id           String   @id @default(uuid()) @db.Uuid
  clientId     String   @db.Uuid
  name         String
  serviceId    String?  @db.Uuid // the catalog service they handle (S3+)
  serviceLabel String? // legacy free-text label (pre-S3 rows); shown until edited
  role         String?
  phone        String?
  email        String?
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  client  Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  service Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([serviceId])
}

model ClientServiceCategory {
  clientId  String @db.Uuid
  serviceId String @db.Uuid

  client  Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([clientId, serviceId])
}

model Subscription {
  id              String        @id @default(uuid()) @db.Uuid
  clientId        String        @db.Uuid
  companyId       String?       @db.Uuid
  serviceId       String        @db.Uuid
  amount          Int // minor units, per period
  period          BillingPeriod
  // per-client billing timing; null = inherit the service preset (legacy rows)
  invoiceTrigger  InvoiceTrigger?
  invoiceDay      Int?
  dueDays         Int? // per-client overdue terms; null = inherit the service preset
  rhythmOverrides Json? // per-client task-template rhythm/deadline overrides
  active          Boolean       @default(true)
  // billing anchor (S7): invoices are never issued for periods before this — set on create and
  // moved to "now" on reactivation, so a paused subscription is never back-billed. Null = createdAt.
  billingStartAt  DateTime?
  startedAt       DateTime      @default(now())
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  client         Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  company        Company?  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  service        Service   @relation(fields: [serviceId], references: [id])
  generatedTasks Task[]
  invoices       Invoice[]

  @@index([clientId])
  @@index([active])
}

// ── Leads ────────────────────────────────────────────────────────────────────

model Lead {
  id                String      @id @default(uuid()) @db.Uuid
  name              String // the person to talk to
  // informational, mirrors Client.companyName — carried straight over on convert (2026-07-26,
  // when leads lost their individual/company discriminator along with clients)
  companyName       String?
  phone             String?
  email             String?
  serviceId         String?     @db.Uuid
  sourceId          String?     @db.Uuid
  description       String?
  stage             LeadStage   @default(first_contact)
  outcome           LeadOutcome @default(in_process)
  convertedClientId String?     @unique @db.Uuid
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  archivedAt        DateTime?
  archivedById      String?     @db.Uuid

  service         Service?      @relation(fields: [serviceId], references: [id])
  source          SourceOption? @relation(fields: [sourceId], references: [id])
  convertedClient Client?       @relation("LeadConvertedClient", fields: [convertedClientId], references: [id])
  tasks           Task[]
  meetings        Meeting[]

  @@index([stage])
  @@index([archivedAt])
}

// ── Tasks ────────────────────────────────────────────────────────────────────

model TaskColumn {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  order     Int
  isFixed   Boolean  @default(false) // "New" — non-editable/deletable, default entry
  createdAt DateTime @default(now())

  tasks Task[]
}

model Task {
  id             String    @id @default(uuid()) @db.Uuid
  title          String
  clientId       String?   @db.Uuid
  companyId      String?   @db.Uuid // which of the client's companies (null = client root)
  leadId         String?   @db.Uuid
  serviceId      String?   @db.Uuid
  kind           TaskKind  @default(once)
  priorityId     String    @db.Uuid
  statusColumnId String    @db.Uuid
  done           Boolean   @default(false)
  // when `done` was set — the Done view filters by it ("last 7 days") and S12 reports on it.
  // Cleared on reopen, so it always describes the CURRENT completion, not an old one.
  completedAt    DateTime?
  deadline       DateTime?
  plannedMinutes Int?
  amount         Int? // minor units; one-off price -> invoice
  invoiceId      String?   @db.Uuid
  description    String?
  // generation idempotency (scheduler): unique per subscription+template+period
  subscriptionId String?   @db.Uuid
  taskTemplateId String?   @db.Uuid
  periodKey      String? // e.g. "2026-07" / "2026-Q3" / "2026-W29"
  createdById    String?   @db.Uuid // who created it (null = auto-generated by the scheduler)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  archivedAt     DateTime?
  archivedById   String?   @db.Uuid

  createdBy    User?         @relation("TaskCreatedBy", fields: [createdById], references: [id])
  client       Client?       @relation(fields: [clientId], references: [id])
  // Restrict: a task's company/service is its provenance — deleting either must be refused,
  // not silently blanked (the catalog + company guards say so in the app; this is the backstop)
  company      Company?      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  lead         Lead?         @relation(fields: [leadId], references: [id])
  service      Service?      @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  priority     Priority      @relation(fields: [priorityId], references: [id])
  statusColumn TaskColumn    @relation(fields: [statusColumnId], references: [id])
  invoice      Invoice?      @relation(fields: [invoiceId], references: [id])
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])
  taskTemplate TaskTemplate? @relation(fields: [taskTemplateId], references: [id])
  assignees    TaskAssignee[]
  timeEntries  TimeEntry[]
  subtasks     Subtask[]
  comments     TaskComment[]

  @@unique([subscriptionId, taskTemplateId, periodKey])
  // partial unique index `Task_internal_template_period` (raw SQL, not expressible here) — dedups
  // internal generated tasks by (taskTemplateId, periodKey) when subscriptionId IS NULL
  @@index([clientId])
  @@index([createdById])
  @@index([done])
  @@index([completedAt])
  @@index([deadline])
  @@index([archivedAt])
}

model TaskAssignee {
  taskId String @db.Uuid
  userId String @db.Uuid

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
}

enum TimeEntrySource {
  timer // live start/stop by the user themself
  manual // added by an admin (forgotten/corrected time)
}

/// One tracked INTERVAL (S6 redesign). `stoppedAt` null = the timer is running.
/// A user has at most one running interval across all tasks (partial unique
/// index `TimeEntry_one_running_per_user` — raw SQL, not representable in Prisma).
/// Closing a timer interval requires a comment; admins have full management.
model TimeEntry {
  id          String          @id @default(uuid()) @db.Uuid
  taskId      String          @db.Uuid
  userId      String          @db.Uuid
  startedAt   DateTime
  stoppedAt   DateTime? // null = running
  seconds     Int? // fixed at stop (admin-editable); null while running
  comment     String? // what was done — required when a timer interval closes
  source      TimeEntrySource @default(timer)
  createdById String?         @db.Uuid // admin who added a manual entry (null = the user themself)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  task      Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdBy User? @relation("TimeEntryCreatedBy", fields: [createdById], references: [id])

  @@index([taskId])
  @@index([userId])
}

model Subtask {
  id     String  @id @default(uuid()) @db.Uuid
  taskId String  @db.Uuid
  text   String
  done   Boolean @default(false)
  order  Int     @default(0)

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

// Free-text note on a task — people leave notes for themselves or colleagues.
model TaskComment {
  id        String   @id @default(uuid()) @db.Uuid
  taskId    String   @db.Uuid
  authorId  String   @db.Uuid
  body      String
  createdAt DateTime @default(now())

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User @relation("TaskCommentAuthor", fields: [authorId], references: [id])

  @@index([taskId])
}

// ── Payments ─────────────────────────────────────────────────────────────────

model Invoice {
  id             String    @id @default(uuid()) @db.Uuid
  number         String    @unique // per Settings format, e.g. INV-2026-0001
  clientId       String    @db.Uuid // required — the invoice's owner (client-primary)
  companyId      String?   @db.Uuid // which of that client's companies (null = individual)
  serviceId      String?   @db.Uuid
  subscriptionId String?   @db.Uuid
  periodKey      String? // set for per-period invoices; unique with subscriptionId
  amount         Int // minor units; balance/status/overdue are derived from amount vs paidTotal
  // Σ payments, kept in step INSIDE every payment transaction. Denormalized on purpose: it lets
  // the list filter/sort/total by settlement in SQL instead of scanning invoices in memory.
  paidTotal      Int      @default(0)
  description    String? // free text on a manually issued invoice
  dueDate        DateTime?
  issuedAt       DateTime  @default(now())
  createdById    String?   @db.Uuid // who issued it manually; null = generated by the scheduler/a job
  // delivery state, orthogonal to payment: null = created (not sent yet), set = handed to the
  // client. Marked by hand today; the email/PDF path (S10) will stamp it automatically.
  sentAt         DateTime?
  sentById       String?   @db.Uuid
  // cancelled = voided (never deleted): keeps history, drops out of debt and the unpaid list
  cancelledAt    DateTime?
  cancelledById  String?   @db.Uuid
  // archived = settled business tidied away: hidden from the working lists, still queryable.
  // Only a zero-balance invoice (paid or cancelled) can be archived, so debt is never hidden.
  archivedAt     DateTime?
  archivedById   String?   @db.Uuid
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  client       Client            @relation(fields: [clientId], references: [id])
  company      Company?          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  // Restrict, not SetNull: an invoice must never lose what it was for. The catalog/company
  // guards refuse the delete in the app; this makes the database refuse it too.
  service      Service?          @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  subscription Subscription?     @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  createdBy    User?             @relation("InvoiceCreatedBy", fields: [createdById], references: [id])
  sentBy       User?             @relation("InvoiceSentBy", fields: [sentById], references: [id])
  cancelledBy  User?             @relation("InvoiceCancelledBy", fields: [cancelledById], references: [id])
  archivedBy   User?             @relation("InvoiceArchivedBy", fields: [archivedById], references: [id])
  tasks        Task[]
  payments     Payment[]
  auditLogs    PaymentAuditLog[]

  @@unique([subscriptionId, periodKey])
  @@index([clientId])
  @@index([dueDate])
  @@index([sentAt])
  @@index([archivedAt])
  // the working list is "this firm's live invoices, newest first" — one index answers it
  @@index([cancelledAt, archivedAt, issuedAt])
}

model Payment {
  id          String   @id @default(uuid()) @db.Uuid
  invoiceId   String   @db.Uuid
  amount      Int // minor units
  paidAt      DateTime
  reference   String? // external reconcile number (bank statement / accounting system)
  createdById String   @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  createdBy User    @relation("PaymentCreatedBy", fields: [createdById], references: [id])

  @@index([invoiceId])
}

model PaymentAuditLog {
  id        String             @id @default(uuid()) @db.Uuid
  invoiceId String             @db.Uuid
  paymentId String?            @db.Uuid // null after delete; snapshot lives in before/after
  action    PaymentAuditAction
  byUserId  String             @db.Uuid
  before    Json?
  after     Json?
  createdAt DateTime           @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  byUser  User    @relation(fields: [byUserId], references: [id])

  @@index([invoiceId])
}

// ── Calendar ─────────────────────────────────────────────────────────────────

model Meeting {
  id              String    @id @default(uuid()) @db.Uuid
  title           String
  clientId        String?   @db.Uuid // client OR lead OR internal (both null)
  leadId          String?   @db.Uuid
  serviceId       String?   @db.Uuid
  startAt         DateTime
  durationMinutes Int
  link            String? // video-call URL
  description     String?
  cancelledAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  client       Client?              @relation(fields: [clientId], references: [id])
  lead         Lead?                @relation(fields: [leadId], references: [id])
  service      Service?             @relation(fields: [serviceId], references: [id])
  participants MeetingParticipant[]

  @@index([startAt])
}

model MeetingParticipant {
  meetingId String @db.Uuid
  userId    String @db.Uuid

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([meetingId, userId])
}

// ── Notifications ────────────────────────────────────────────────────────────

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  kind      NotificationKind
  text      String
  sub       String?
  linkType  String? // e.g. "task" | "meeting" | "invoice"
  linkId    String?          @db.Uuid
  dedupKey  String? // scheduler triggers: no re-notify on re-scan
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupKey])
  @@index([userId, read])
}

// ── Mailouts ─────────────────────────────────────────────────────────────────

model EmailTemplate {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  subject   String
  body      String // rich text with merge-vars
  variables Json?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaigns Campaign[]
  reminders Reminder[]
}

model Campaign {
  id             String           @id @default(uuid()) @db.Uuid
  name           String
  templateId     String           @db.Uuid
  audience       CampaignAudience
  audienceConfig Json? // service id / debt threshold / manual client ids
  schedule       CampaignSchedule
  scheduleConfig Json? // date / recurrence
  enabled        Boolean          @default(false)
  lastRunAt      DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  template EmailTemplate @relation(fields: [templateId], references: [id])
}

model Reminder {
  id         String    @id @default(uuid()) @db.Uuid
  clientId   String    @db.Uuid
  templateId String    @db.Uuid
  date       DateTime
  sentAt     DateTime?
  createdAt  DateTime  @default(now())

  client   Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  template EmailTemplate @relation(fields: [templateId], references: [id])

  @@index([date, sentAt])
}

// ── Files ────────────────────────────────────────────────────────────────────

model File {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  size         Int // bytes, ≤ 25 MB enforced in service
  mime         String
  path         String // relative path on the uploads volume
  clientId     String?  @db.Uuid // client-card files
  uploadedById String   @db.Uuid
  createdAt    DateTime @default(now())

  client        Client?      @relation("ClientFiles", fields: [clientId], references: [id], onDelete: Cascade)
  uploadedBy    User         @relation("FileUploadedBy", fields: [uploadedById], references: [id])
  avatarOfUser  User?        @relation("UserAvatar")
  logoOfProfile FirmProfile?

  @@index([clientId])
}
