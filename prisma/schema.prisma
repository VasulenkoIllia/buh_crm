// buh_crm — ER schema v1 (S0). All entities up front; modules land stage by stage.
// Conventions: uuid PKs, createdAt/updatedAt, currency = USD integer minor units (cents),
// soft delete via archivedAt/archivedBy on archivables, derived values never stored.

generator client {
  provider = "prisma-client"
  output   = "../server/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  admin
  user
}

enum UserStatus {
  invited
  pending
  active
  blocked
}

enum AuthTokenType {
  invite
  email_confirm
  password_reset
}

enum ServiceType {
  subscription
  one_time
  internal
}

enum InvoiceTrigger {
  on_create
  on_complete
  on_period_start
  on_period_end
}

enum BillingPeriod {
  month
  quarter
  year
}

enum Periodicity {
  weekly
  monthly
  quarterly
  yearly
  once
}

enum TaskKind {
  once // one-off billable
  sub // generated from subscription
  free // internal, non-billable
}

enum LeadStage {
  first_contact
  no_answer
  set_up_meeting
  thinking
  on_hold
  next_time
}

enum LeadOutcome {
  in_process
  won
  lost
}

enum PaymentAuditAction {
  created
  updated
  deleted
}

/// What happened to a client secret. `unlock_failed` is journalled too: a run of them is the only
/// signal that somebody is guessing a password.
enum SecretAuditAction {
  created
  updated
  deleted
  revealed
  unlock_failed
}

enum NotificationKind {
  task
  meeting
  invoice
  system
}

/**
 * The line the CAN-SPAM Act draws, and the reason it is stored rather than inferred.
 * `commercial` mail (news, offers, seasonal reminders) must carry a working unsubscribe and the
 * firm's postal address, and must honour an unsubscribe. `transactional` mail (an invoice, a
 * password reset, a document request) is exempt from all three — and MUST stay exempt, because a
 * client who unsubscribes from news still has to receive their bill.
 */
enum MailoutKind {
  commercial
  transactional
}

/**
 * What happened to one recipient of one send. `skipped` is a record, never a silent drop.
 */
/// How often a campaign fires. `once` is a scheduled one-off — same entity, no special case.
///
/// `dates` is a hand-picked list rather than a rule: an accounting firm's calendar is 15 March,
/// 15 April, 15 September — deadlines, not a rhythm, and forcing them into "every quarter" would
/// be a lie the sweep then acts on.
enum CampaignRhythm {
  once
  dates
  monthly
  quarterly
  yearly
}

/// `scheduled` is the only state that fires. `stopped` was ended by hand and can be resumed;
/// `finished` ran out of dates and cannot. Both are kept rather than deleted — a campaign that
/// sent letters is history, and the letters point back at it.
enum CampaignStatus {
  scheduled
  stopped
  finished
}

enum MailoutStatus {
  queued
  sent
  failed
  skipped
  /**
   * a delivery report came back — the letter was handed over and then refused
   */
  bounced
}

/**
 * What a delivery report was ABOUT, which decides what may be done in response.
 */
enum BounceKind {
  /**
   * the recipient's mailbox is gone — the only kind that may retire an address
   */
  address
  /**
   * a mail system between us and them, quite possibly our own — blame no address for it
   */
  system
  /**
   * the message itself was unacceptable, usually its size
   */
  letter
  /**
   * 4.x.x, still being retried — recorded, but nothing acts on it
   */
  transient
}

// ── Users & auth ─────────────────────────────────────────────────────────────

model User {
  id               String     @id @default(uuid()) @db.Uuid
  firstName        String
  lastName         String
  email            String     @unique
  passwordHash     String?
  role             UserRole   @default(user)
  status           UserStatus @default(invited)
  avatarFileId     String?    @unique @db.Uuid
  emailConfirmedAt DateTime?
  invitedAt        DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  avatarFile               File?                  @relation("UserAvatar", fields: [avatarFileId], references: [id])
  authTokens               AuthToken[]
  sessions                 Session[]
  taskAssignments          TaskAssignee[]
  tasksCreated             Task[]                 @relation("TaskCreatedBy")
  tasksCancelled           Task[]                 @relation("TaskCancelledBy")
  secretsCreated           ClientSecret[]         @relation("SecretCreatedBy")
  secretAudit              SecretAuditLog[]       @relation("SecretAuditBy")
  taskComments             TaskComment[]          @relation("TaskCommentAuthor")
  timeEntries              TimeEntry[]
  timeEntriesCreated       TimeEntry[]            @relation("TimeEntryCreatedBy")
  meetingParticipants      MeetingParticipant[]
  meetingsOrganised        Meeting[]              @relation("MeetingCreatedBy")
  notifications            Notification[]
  paymentsCreated          Payment[]              @relation("PaymentCreatedBy")
  paymentAuditLogs         PaymentAuditLog[]
  invoicesCreated          Invoice[]              @relation("InvoiceCreatedBy")
  invoicesSent             Invoice[]              @relation("InvoiceSentBy")
  invoicesCancelled        Invoice[]              @relation("InvoiceCancelledBy")
  invoicesArchived         Invoice[]              @relation("InvoiceTidiedBy")
  uploadedFiles            File[]                 @relation("FileUploadedBy")
  subscriptionPeriods      SubscriptionPeriod[]   @relation("SubscriptionPeriodCreatedBy")
  subscriptionPeriodsEnded SubscriptionPeriod[]   @relation("SubscriptionPeriodEndedBy")
  mailoutsSent             Mailout[]              @relation("MailoutCreatedBy")
  campaignsCreated         Campaign[]             @relation("CampaignCreatedBy")
  clientsUnsubscribed      ClientMailPreference[] @relation("MailPreferenceUnsubscribedBy")
  deadEmailAddresses       DeadEmailAddress[]
  clientPins               ClientPin[]
}

model AuthToken {
  id        String        @id @default(uuid()) @db.Uuid
  userId    String        @db.Uuid
  type      AuthTokenType
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

model Session {
  id        String   @id // session id from the cookie
  userId    String   @db.Uuid
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ── Settings ─────────────────────────────────────────────────────────────────

model Priority {
  id        String  @id @default(uuid()) @db.Uuid
  name      String  @unique
  color     String
  order     Int
  isDefault Boolean @default(false)

  tasks Task[]
}

model SourceOption {
  id     String  @id @default(uuid()) @db.Uuid
  name   String  @unique
  order  Int
  active Boolean @default(true)

  clients Client[]
  leads   Lead[]
}

model FirmProfile {
  id                   Int     @id @default(1) // singleton row
  name                 String
  logoFileId           String? @unique @db.Uuid
  // invoice numbering (decision 2026-07-17): PREFIX-YEAR-NNNN, yearly counter reset
  invoicePrefix        String  @default("INV")
  invoiceCounterDigits Int     @default(4)
  // allocated counter (S7): the last number handed out for `invoiceCounterYear`. Bumped inside a
  // transaction so concurrent issues never collide; resets when the firm year rolls over.
  invoiceCounterYear   Int?
  invoiceCounter       Int     @default(0)
  currency             String  @default("USD")

  // ── Mailouts (S10) ────────────────────────────────────────────────────────
  //
  // Only the firm-wide part lives here. Everything about a SENDER — From, signature, SMTP
  // credentials — moved to `MailSenderAccount` on 2026-08-11, because a firm sends different kinds
  // of letter from different mailboxes (news from info@, bills from billing@) and one set of
  // fields could only ever describe one of them.
  //
  /**
   * /**
   * /**
   * /**
   * /**
   * /**
   * /**
   * /** CAN-SPAM: the firm's physical address. One firm, one legal address — never per mailbox.
   */
  postalAddress  String?
  /**
   * The mark that goes in LETTERS — deliberately its own file, not `logoFileId`.
   * The sidebar logo and the letterhead have different jobs: the sidebar is small, sits on a dark
   * panel and can be any shape; the letterhead is 168px wide on white and needs a tight raster
   * crop at the lockup's own aspect. One file could serve both only by being wrong for one of them.
   */
  mailLogoFileId String? @unique @db.Uuid

  logoFile     File? @relation("FirmLogo", fields: [logoFileId], references: [id])
  mailLogoFile File? @relation("FirmMailLogo", fields: [mailLogoFileId], references: [id])
}

/**
 * A mailbox the firm sends client letters from.
 * Several, because the letters are not all of a kind: seasonal news from `info@`, invoices from
 * `billing@`, document requests from a particular accountant. Each carries its own `From`, its own
 * signature — the block at the foot of the letter names a *person*, and that person differs by
 * mailbox — and its own SMTP credentials.
 * `smtpHost` null means "send over the `.env` account", so a firm can name a sender and start
 * using it before its DNS and credentials are ready.
 * Never hard-deleted: a `Mailout` records which account it went from, and history that points at a
 * missing row stops being able to answer "where did this come from". Deactivate instead.
 */
model MailSenderAccount {
  id   String @id @default(uuid()) @db.Uuid
  /**
   * what the firm calls it — "Newsletters", "Invoices". Unique, case-insensitively.
   */
  name String

  /**
   * the From: header — the address must be one the SMTP account below may send AS
   */
  fromName  String
  fromEmail String
  replyTo   String?
  /**
   * the contact block at the foot of every letter sent from here — a NAME and title, not data
   */
  signature String?

  // ── the tap-to-contact buttons ────────────────────────────────────────────
  //
  // Explicit fields, not parsed out of the signature. Reading them from free text meant GUESSING
  // whether a line meant Telegram or a plain call, and a number written a new way produced a dead
  // link nobody noticed. Each field here is one button, in a fixed order; empty means no button.
  contactEmail    String?
  contactPhone    String?
  contactTelegram String?
  contactWhatsapp String?
  contactViber    String?
  contactWebsite  String?

  /**
   * The mailbox invoices go out from, once Payments starts sending them.
   * A named purpose rather than a second "default": the firm decides once that bills come from
   * billing@ and news from info@, and the invoice code then has somewhere to read instead of
   * inventing its own setting later.
   */
  isInvoiceSender Boolean @default(false)

  /**
   * null = borrow the `.env` account that sends invites and password resets
   */
  smtpHost       String?
  smtpPort       Int?
  smtpSecure     Boolean?
  smtpUser       String?
  /// sealed with SECRETS_KEY, exactly like ClientSecret — never returned by the API
  smtpPass       Bytes?
  smtpPassIv     Bytes?
  smtpPassTag    Bytes?
  smtpKeyVersion Int?

  // ── reading the mailbox back ──────────────────────────────────────────────
  //
  // A mailbox that only sends is half a mailbox. Bounces come back to the envelope sender, and the
  // hosting decides which mailbox that is — so this is CONFIGURED, never inferred from `fromEmail`.
  // Null host means "not read", which is a state the screen says out loud rather than implying
  // coverage that does not exist.
  //
  // The reader matches on a key carried inside the bounce, so it does not matter which mailbox a
  // given bounce lands in: every configured mailbox is polled, and whatever turns up is matched.
  /**
   * /**
   * /**
   * /**
   * /**
   * /**
   * /**
   * /** null = this mailbox is not read for bounces
   */
  imapHost       String?
  imapPort       Int?
  imapSecure     Boolean?
  /**
   * null = reuse smtpUser / smtpPass, which is the usual case and what the form offers first
   */
  imapUser       String?
  /// sealed with SECRETS_KEY, exactly like smtpPass — never returned by the API
  imapPass       Bytes?
  imapPassIv     Bytes?
  imapPassTag    Bytes?
  imapKeyVersion Int?

  // ── the reader's own bookmark ─────────────────────────────────────────────
  //
  // Never `\Seen`, never a moved message: this mailbox belongs to a person, and flagging their
  // mail to track our own progress would hide a bounce from them — or theirs from us.
  /**
   * /**
   * /**
   * /**
   * /**
   * /**
   * /** the mailbox's UIDVALIDITY when last read; a change means the UIDs were reissued
   */
  bounceUidValidity String?
  /**
   * the highest UID already read, so a restart resumes rather than rescans
   */
  bounceLastUid     Int?
  /**
   * When the mailbox was last read successfully.
   * Load-bearing beyond bookkeeping: a letter is only called DELIVERED once this proves we looked
   * after it was sent and found no complaint. Silence is evidence only when somebody was listening.
   */
  bounceCheckedAt   DateTime?
  /**
   * the last failure, shown beside the mailbox so a broken reader is visible rather than silent
   */
  bounceError       String?

  /**
   * exactly one account is the default; moved atomically, like Priority.isDefault
   */
  isDefault Boolean  @default(false)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mailouts  Mailout[]
  campaigns Campaign[]
  templates EmailTemplate[]

  @@index([active])
}

// ── Catalog ──────────────────────────────────────────────────────────────────

model Service {
  id                  String         @id @default(uuid()) @db.Uuid
  name                String         @unique // is the category label
  color               String
  type                ServiceType
  defaultAmount       Int? // minor units — expected price; per-client override on Subscription.amount
  invoiceTrigger      InvoiceTrigger @default(on_create)
  invoiceDay          Int? // "on day N of the period" (design: billing rule sub-panel)
  dueDays             Int? // invoice counts as overdue N days after issue; null = never
  active              Boolean        @default(true)
  /// Where the service sits in the catalog, ascending — the firm's own order, dragged by hand.
  ///
  /// One read feeds the whole app (`listServices`), so this order is what every service picker,
  /// chip row and filter shows: setting it once on the Services page settles it everywhere
  /// (user, 2026-08-27). Back-filled from `createdAt`, which is what the list was sorted by
  /// before, so no screen changed the day it landed.
  order               Int            @default(0)
  // at most ONE service (one-time only) is auto-added to every new client — enforced by the
  // partial unique index `Service_single_default_for_new_clients` (raw SQL, not expressible here)
  autoAddToNewClients Boolean        @default(false)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  taskTemplates TaskTemplate[]
  subscriptions Subscription[]
  tasks         Task[]
  leads         Lead[]
  invoices      Invoice[]
  meetings      Meeting[]
  people        ClientPerson[]

  // the catalog's own read order. The index exists in the database — the 2026-08-27 migration
  // created it — but the model had never declared it, so every schema diff wanted to drop it.
  @@index([order])
}

model TaskTemplate {
  id                 String      @id @default(uuid()) @db.Uuid
  serviceId          String      @db.Uuid
  name               String
  periodicity        Periodicity
  dayOfPeriod        Int? // weekly: 1-7 (Mon=1); monthly/quarterly/yearly: 1-31 or -1 = last day
  monthOfPeriod      Int? // quarterly: 1-3 (month of quarter); yearly: 1-12
  deadlineOffsetDays Int? // deadline = createdAt + offset; null = no deadline
  estimatedMinutes   Int? // planned labor default; per-task override via Task.plannedMinutes
  defaultChecklist   Json? // string[] of default checklist steps → seeded onto generated/created tasks
  description        String? // seeded into the generated task's description
  defaultAssigneeIds Json? // uuid[] of default assignees → seeded onto generated tasks
  billable           Boolean     @default(true)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@index([serviceId])
}

// ── Clients ──────────────────────────────────────────────────────────────────

// Client model rework 2026-07-26 (supersedes the 2026-07-18 "one entity with a type" reset):
// a client is just a client — no individual/company discriminator. `companyName` survives as a
// plain informational label; the COMPANIES a client holds are real rows below.
model Client {
  id           String    @id @default(uuid()) @db.Uuid
  /// The short handle staff say out loud to each other — rendered `C-042`, stored as the bare
  /// number so it sorts numerically and the format can change without touching the data.
  ///
  /// The DATABASE hands it out, not the application. A client is created from the Clients page,
  /// the meeting form, the task form, the import scripts and — in a transaction of its own — lead
  /// conversion; a counter in application code would have to be threaded through every one of
  /// them, and any path added later would silently produce a client with no code. Invoices keep
  /// their own counter because accounting demands numbering with no gaps; a gap here costs
  /// nothing (user, 2026-08-28).
  code         Int       @unique @default(autoincrement())
  firstName    String // the client's identity — required; lastName is optional
  lastName     String?
  companyName  String? // informational only ("works at / trades as"), never an identity
  phone        String?
  email        String?
  address      String?
  sourceId     String?   @db.Uuid
  description  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  archivedAt   DateTime?
  archivedById String?   @db.Uuid

  /// Restrict, not the default SetNull: a source may only be deleted while nothing records it,
  /// and the database is what makes that true rather than a count taken a moment earlier.
  source         SourceOption?         @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  companies      Company[] // 1:N — the client's companies (see below)
  people         ClientPerson[] // the "People" tab
  secrets        ClientSecret[] // the "Secrets" tab — encrypted, admin-only reveal
  secretAudit    SecretAuditLog[]
  subscriptions  Subscription[]
  tasks          Task[]
  invoices       Invoice[]
  meetings       Meeting[]
  mailouts       MailoutRecipient[]
  campaigns      CampaignRecipient[]
  mailPreference ClientMailPreference?
  files          File[]                @relation("ClientFiles")
  convertedLead  Lead?                 @relation("LeadConvertedClient")
  pins           ClientPin[]

  @@index([archivedAt])
}

/// A company OWNED BY ONE CLIENT (2026-07-26) — the invoicing / task / report dimension that
/// `companyId` points at. A client may hold many; a company belongs to exactly one.
/// `companyId = null` anywhere else means "the client directly, no company" — which is the
/// normal case for a client that holds none.
/// `name` is unique across the WHOLE system, case-insensitively: the unique index lives in raw
/// SQL (`Company_name_key_ci` on lower(name)) because Prisma can't express a functional index —
/// see server/schema-invariants.test.ts, which guards it.
model Company {
  id          String   @id @default(uuid()) @db.Uuid
  clientId    String   @db.Uuid
  name        String
  // optional contact details — `email` is where this company's invoices will be sent (S10);
  // with none set the client's own email is the fallback
  phone       String?
  email       String?
  description String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  client        Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  subscriptions Subscription[]
  invoices      Invoice[]
  tasks         Task[]
  mailouts      MailoutRecipient[]
  campaigns     CampaignRecipient[]

  @@index([clientId])
}

/// A client one USER keeps at the top of their list.
///
/// PER-USER, not per-firm (2026-08-26). "The clients I am working through this week" is a personal
/// working set; a shared pin would let one accountant reorder everyone else's screen, and the
/// second person to use it would have to undo the first. The composite primary key is the whole
/// constraint — a user can pin a client once, and un-pinning is a delete.
///
/// Cascades from both sides: an archived-then-deleted client, or a removed user, must not leave a
/// pin pointing at nothing. `createdAt` is kept so the pinned block can be ordered by when each was
/// pinned if that is ever wanted; today it follows the list's own sort.
model ClientPin {
  userId    String   @db.Uuid
  clientId  String   @db.Uuid
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@id([userId, clientId])
  @@index([clientId])
}

// The "People" tab — people involved with a client + the service they handle.
/// A credential the firm holds for a client — tax portal, client-bank, КЕП.
///
/// `label` and `description` are readable by anyone who can open the client; the VALUE is
/// encrypted at rest (AES-256-GCM, key from `SECRETS_KEY`) and only an admin can reveal it, with
/// their own password, for five minutes (decision 2026-08-01). The list endpoint never returns
/// the ciphertext, let alone the plaintext.
///
/// All three crypto columns are NULL for a **pointer-only** entry: something too sensitive to hold
/// at all, recorded as "it lives in the firm's password manager, item X" and nothing more.
model ClientSecret {
  id          String   @id @default(uuid()) @db.Uuid
  clientId    String   @db.Uuid
  label       String
  description String?
  ciphertext  Bytes? // null = pointer-only entry, nothing stored
  iv          Bytes?
  authTag     Bytes?
  /// which SECRETS_KEY encrypted this, so the key can be rotated later without guessing
  keyVersion  Int      @default(1)
  order       Int      @default(0)
  createdById String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  client    Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdBy User?            @relation("SecretCreatedBy", fields: [createdById], references: [id])
  auditLog  SecretAuditLog[]

  @@index([clientId])
}

/// Who touched a secret, and when. Modelled on `PaymentAuditLog`; a reveal is an event worth
/// keeping even though nothing changed.
model SecretAuditLog {
  id        String            @id @default(uuid()) @db.Uuid
  secretId  String?           @db.Uuid // null for an unlock attempt, which targets a client
  clientId  String            @db.Uuid
  byUserId  String            @db.Uuid
  action    SecretAuditAction
  /// the secret's name AS IT WAS — the FK goes null when the secret is deleted, and a log that
  /// cannot say what it was about is not worth keeping
  label     String?
  ip        String?
  createdAt DateTime          @default(now())

  secret ClientSecret? @relation(fields: [secretId], references: [id], onDelete: SetNull)
  client Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  byUser User          @relation("SecretAuditBy", fields: [byUserId], references: [id])

  @@index([clientId, createdAt])
  @@index([byUserId])
}

model ClientPerson {
  id           String   @id @default(uuid()) @db.Uuid
  clientId     String   @db.Uuid
  name         String
  serviceId    String?  @db.Uuid // the catalog service they handle (S3+)
  serviceLabel String? // legacy free-text label (pre-S3 rows); shown until edited
  role         String?
  phone        String?
  email        String?
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  client   Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  service  Service?  @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  meetings Meeting[]

  @@index([clientId])
  @@index([serviceId])
}

model Subscription {
  id              String          @id @default(uuid()) @db.Uuid
  clientId        String          @db.Uuid
  companyId       String?         @db.Uuid
  serviceId       String          @db.Uuid
  amount          Int // minor units, per period for a subscription; per JOB for a one-time service
  /// NULL for a one-time service, which has no period at all (2026-08-26).
  ///
  /// It used to store `month` there with a comment saying the value was unused — and the clients
  /// list picked it up and printed "monthly" beside a total that had one-time job prices added
  /// into it. A field that means nothing is one any reader may believe; the only fix that holds is
  /// for it not to exist. The service layer derives this from the service's type and never trusts
  /// a caller with it.
  period          BillingPeriod?
  // per-client billing timing; null = inherit the service preset (legacy rows)
  invoiceTrigger  InvoiceTrigger?
  invoiceDay      Int?
  dueDays         Int? // per-client overdue terms; null = inherit the service preset
  rhythmOverrides Json? // per-client task-template rhythm/deadline overrides
  /// the client's usual service — prefills every service picker for them. At most one per client
  /// (partial unique index `Subscription_one_default_per_client`, raw SQL); a default can't be
  /// stopped until the flag is cleared.
  isDefault       Boolean         @default(false)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  client         Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  company        Company?             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  service        Service              @relation(fields: [serviceId], references: [id])
  generatedTasks Task[]
  invoices       Invoice[]
  periods        SubscriptionPeriod[]

  @@index([clientId])
}

/// When a subscription was actually IN FORCE — the answer to "was this client being served on
/// day X", which both the task sweep and the billing sweep ask (decision 2026-07-29).
///
/// A pause closes the open period; a resume opens a new one. Stored as a LIST, not a mutable
/// from/to pair: the next pause would overwrite the pair and the past would be gone, and then
/// "was August fully served" becomes unanswerable — which is exactly the bug this replaces.
///
/// HALF-OPEN on purpose: `startsOn` is the first day in force, `endsBefore` the first day NOT in
/// force. Pausing "on 20 Aug" stores 21 Aug (the UI says "до 20.08 включно"), so pause-and-resume
/// on the same day leaves NO gap and the month stays fully covered. `endsBefore = null` means
/// open-ended, which is the normal state — nothing in the system can expire a subscription.
///
/// `@db.Date` deliberately: a period is a calendar day and a time-of-day slipping in would break
/// every coverage comparison. The column makes that structurally impossible.
model SubscriptionPeriod {
  id             String    @id @default(uuid()) @db.Uuid
  subscriptionId String    @db.Uuid
  startsOn       DateTime  @db.Date
  endsBefore     DateTime? @db.Date
  /// a period has two stories — why it started and why it ended. One shared column meant pausing
  /// overwrote what the resume had recorded, so each gets its own.
  startNote      String?
  endNote        String?
  createdById    String?   @db.Uuid // who opened it (null = migrated or automatic)
  endedById      String?   @db.Uuid // who closed it
  createdAt      DateTime  @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation("SubscriptionPeriodCreatedBy", fields: [createdById], references: [id])
  endedBy      User?        @relation("SubscriptionPeriodEndedBy", fields: [endedById], references: [id])
  // partial unique index `Subscription_one_open_period` (raw SQL — Prisma can't express a WHERE
  // on an index) keeps at most ONE open period per subscription. Asserted in schema-invariants.

  @@index([subscriptionId, startsOn])
}

// ── Leads ────────────────────────────────────────────────────────────────────

model Lead {
  id                String      @id @default(uuid()) @db.Uuid
  name              String // the person to talk to
  // informational, mirrors Client.companyName — carried straight over on convert (2026-07-26,
  // when leads lost their individual/company discriminator along with clients)
  companyName       String?
  phone             String?
  email             String?
  serviceId         String?     @db.Uuid
  sourceId          String?     @db.Uuid
  description       String?
  stage             LeadStage   @default(first_contact)
  /// Where the lead sits INSIDE its stage on the board. The same idea as `Task.boardOrder`, and
  /// for the same reason: a pipeline column has the order the firm arranged, not the one the
  /// database happened to return (user, 2026-08-28).
  boardOrder        Int         @default(0)
  outcome           LeadOutcome @default(in_process)
  convertedClientId String?     @unique @db.Uuid
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  archivedAt        DateTime?
  archivedById      String?     @db.Uuid

  service         Service?      @relation(fields: [serviceId], references: [id])
  /// Restrict — see the note on `Client.source`.
  source          SourceOption? @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  convertedClient Client?       @relation("LeadConvertedClient", fields: [convertedClientId], references: [id])
  tasks           Task[]
  meetings        Meeting[]

  @@index([stage])
  @@index([archivedAt])
}

// ── Tasks ────────────────────────────────────────────────────────────────────

model TaskColumn {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  order     Int
  isFixed   Boolean  @default(false) // "New" — non-editable/deletable, default entry
  createdAt DateTime @default(now())

  tasks Task[]
}

model Task {
  id             String    @id @default(uuid()) @db.Uuid
  title          String
  clientId       String?   @db.Uuid
  companyId      String?   @db.Uuid // which of the client's companies (null = client root)
  leadId         String?   @db.Uuid
  serviceId      String?   @db.Uuid
  kind           TaskKind  @default(once)
  priorityId     String    @db.Uuid
  statusColumnId String    @db.Uuid
  /// Where the card sits IN its column, ascending — the firm's own order, dragged by hand.
  ///
  /// Board order used to be `createdAt desc` and nothing else, so a card could not be moved up or
  /// down (user, 2026-08-26). Shared, not per-user: a kanban column is a shared queue, and two
  /// people seeing different orders would be arguing about different boards.
  ///
  /// Renumbered 0..n-1 across the WHOLE column on every move, which is what keeps a filtered board
  /// honest: dropping a card below the one above it must not disturb the cards a filter is hiding.
  /// New work takes `min - 1` so it lands on top, which is where the old ordering put it.
  boardOrder     Int       @default(0)
  done           Boolean   @default(false)
  // when `done` was set — the Done view filters by it ("last 7 days") and S12 reports on it.
  // Cleared on reopen, so it always describes the CURRENT completion, not an old one.
  completedAt    DateTime?
  deadline       DateTime?
  plannedMinutes Int?
  amount         Int? // minor units; one-off price -> invoice
  invoiceId      String?   @db.Uuid
  description    String?
  // generation idempotency (scheduler): unique per subscription+template+period
  subscriptionId String?   @db.Uuid
  taskTemplateId String?   @db.Uuid
  periodKey      String? // e.g. "2026-07" / "2026-Q3" / "2026-W29"
  createdById    String?   @db.Uuid // who created it (null = auto-generated by the scheduler)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  archivedAt     DateTime?
  archivedById   String?   @db.Uuid
  /// raised by mistake, or called off. A cancelled task leaves the board but is never deleted:
  /// the row is what keeps the nightly sweep from re-creating a generated one (2026-08-01).
  cancelledAt    DateTime?
  cancelledById  String?   @db.Uuid

  createdBy    User?          @relation("TaskCreatedBy", fields: [createdById], references: [id])
  cancelledBy  User?          @relation("TaskCancelledBy", fields: [cancelledById], references: [id])
  client       Client?        @relation(fields: [clientId], references: [id])
  // Restrict: a task's company/service is its provenance — deleting either must be refused,
  // not silently blanked (the catalog + company guards say so in the app; this is the backstop)
  company      Company?       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  lead         Lead?          @relation(fields: [leadId], references: [id])
  service      Service?       @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  priority     Priority       @relation(fields: [priorityId], references: [id])
  statusColumn TaskColumn     @relation(fields: [statusColumnId], references: [id])
  invoice      Invoice?       @relation(fields: [invoiceId], references: [id])
  /// the meeting this task was opened from, if any (S8)
  meeting      Meeting?
  subscription Subscription?  @relation(fields: [subscriptionId], references: [id])
  taskTemplate TaskTemplate?  @relation(fields: [taskTemplateId], references: [id])
  assignees    TaskAssignee[]
  timeEntries  TimeEntry[]
  subtasks     Subtask[]
  comments     TaskComment[]

  /// set when the SYSTEM raised this task by itself (see shared/system-tasks.ts); null for the
  /// ordinary ones people and templates create. Behind it sits the partial unique index
  /// `Task_system_period` on (subscriptionId, periodKey) — the sweeps run daily and would
  /// otherwise post the same reminder every morning.
  systemKind String?

  @@unique([subscriptionId, taskTemplateId, periodKey])
  // partial unique index `Task_internal_template_period` (raw SQL, not expressible here) — dedups
  // internal generated tasks by (taskTemplateId, periodKey) when subscriptionId IS NULL
  @@index([clientId])
  @@index([createdById])
  @@index([done])
  @@index([completedAt])
  @@index([deadline])
  @@index([archivedAt])
  @@index([cancelledAt])
  // the board reads one column at a time, in order
  @@index([statusColumnId, boardOrder])
}

model TaskAssignee {
  taskId String @db.Uuid
  userId String @db.Uuid

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
}

enum TimeEntrySource {
  timer // live start/stop by the user themself
  manual // added by an admin (forgotten/corrected time)
}

/// One tracked INTERVAL (S6 redesign). `stoppedAt` null = the timer is running.
/// A user has at most one running interval across all tasks (partial unique
/// index `TimeEntry_one_running_per_user` — raw SQL, not representable in Prisma).
/// Closing a timer interval requires a comment; admins have full management.
model TimeEntry {
  id          String          @id @default(uuid()) @db.Uuid
  taskId      String          @db.Uuid
  userId      String          @db.Uuid
  startedAt   DateTime
  stoppedAt   DateTime? // null = running
  seconds     Int? // fixed at stop (admin-editable); null while running
  comment     String? // what was done — required when a timer interval closes
  source      TimeEntrySource @default(timer)
  createdById String?         @db.Uuid // admin who added a manual entry (null = the user themself)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  task      Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdBy User? @relation("TimeEntryCreatedBy", fields: [createdById], references: [id])

  @@index([taskId])
  @@index([userId])
}

model Subtask {
  id     String  @id @default(uuid()) @db.Uuid
  taskId String  @db.Uuid
  text   String
  done   Boolean @default(false)
  order  Int     @default(0)

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

// Free-text note on a task — people leave notes for themselves or colleagues.
model TaskComment {
  id        String   @id @default(uuid()) @db.Uuid
  taskId    String   @db.Uuid
  authorId  String   @db.Uuid
  body      String
  createdAt DateTime @default(now())

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User @relation("TaskCommentAuthor", fields: [authorId], references: [id])

  @@index([taskId])
}

// ── Payments ─────────────────────────────────────────────────────────────────

model Invoice {
  id             String    @id @default(uuid()) @db.Uuid
  number         String    @unique // per Settings format, e.g. INV-2026-0001
  clientId       String    @db.Uuid // required — the invoice's owner (client-primary)
  companyId      String?   @db.Uuid // which of that client's companies (null = individual)
  serviceId      String?   @db.Uuid
  subscriptionId String?   @db.Uuid
  periodKey      String? // set for per-period invoices; unique with subscriptionId
  amount         Int // minor units; balance/status/overdue are derived from amount vs paidTotal
  // Σ payments, kept in step INSIDE every payment transaction. Denormalized on purpose: it lets
  // the list filter/sort/total by settlement in SQL instead of scanning invoices in memory.
  paidTotal      Int       @default(0)
  description    String? // free text on a manually issued invoice
  dueDate        DateTime?
  issuedAt       DateTime  @default(now())
  createdById    String?   @db.Uuid // who issued it manually; null = generated by the scheduler/a job
  // delivery state, orthogonal to payment: null = created (not sent yet), set = handed to the
  // client. Marked by hand today; the email/PDF path (S10) will stamp it automatically.
  sentAt         DateTime?
  sentById       String?   @db.Uuid
  // cancelled = voided (never deleted): keeps history, drops out of debt and the unpaid list
  cancelledAt    DateTime?
  cancelledById  String?   @db.Uuid
  /// TIDIED, not archived: settled business moved out of the working list. Never a deletion, and
  /// only a zero-balance invoice (paid or cancelled) can be tidied, so debt is never hidden. The
  /// name is deliberate — `archivedAt` elsewhere means SOFT-DELETED, and one word for two ideas is
  /// what made a single Archive screen impossible (2026-08-03).
  tidiedAt       DateTime?
  tidiedById     String?   @db.Uuid
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  lines        InvoiceLine[]
  client       Client            @relation(fields: [clientId], references: [id])
  company      Company?          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  // Restrict, not SetNull: an invoice must never lose what it was for. The catalog/company
  // guards refuse the delete in the app; this makes the database refuse it too.
  service      Service?          @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  subscription Subscription?     @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  createdBy    User?             @relation("InvoiceCreatedBy", fields: [createdById], references: [id])
  sentBy       User?             @relation("InvoiceSentBy", fields: [sentById], references: [id])
  cancelledBy  User?             @relation("InvoiceCancelledBy", fields: [cancelledById], references: [id])
  tidiedBy     User?             @relation("InvoiceTidiedBy", fields: [tidiedById], references: [id])
  tasks        Task[]
  payments     Payment[]
  auditLogs    PaymentAuditLog[]

  @@unique([subscriptionId, periodKey])
  @@index([clientId])
  @@index([dueDate])
  @@index([sentAt])
  @@index([tidiedAt])
  // the working list is "this firm's live invoices, newest first" — one index answers it
  @@index([cancelledAt, tidiedAt, issuedAt])
}

/// One position on an invoice — what the total is made of.
///
/// Optional, and that is the design: an invoice with no lines is a single amount, exactly as every
/// invoice was before this existed, and renders unchanged. When lines ARE present the invoice's
/// `amount` is their sum — computed on the server, never taken from the browser — so there is one
/// number for money and one place that decides it.
///
/// `quantity` and `unitRate` are optional too, so one shape covers both "Consultation — 500" and
/// "3.50 h × 200.00 = 700". A stored "invoice type" would have remembered which form was filled
/// in rather than what is true about the document.
model InvoiceLine {
  id          String @id @default(uuid()) @db.Uuid
  invoiceId   String @db.Uuid
  /// display order, 0-based — the firm's ordering, not the insert order
  order       Int
  description String
  /// HUNDREDTHS OF AN HOUR: 2.50 h = 250. Integers like money, for the same reason — a float
  /// hour times a rate is where the last cent goes missing.
  quantity    Int?
  /// minor units per hour
  unitRate    Int?
  /// minor units; = round(quantity × unitRate / 100) when both are set, else as entered
  amount      Int

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model Payment {
  id          String   @id @default(uuid()) @db.Uuid
  invoiceId   String   @db.Uuid
  amount      Int // minor units
  paidAt      DateTime
  reference   String? // external reconcile number (bank statement / accounting system)
  createdById String   @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  createdBy User    @relation("PaymentCreatedBy", fields: [createdById], references: [id])

  @@index([invoiceId])
}

model PaymentAuditLog {
  id        String             @id @default(uuid()) @db.Uuid
  invoiceId String             @db.Uuid
  paymentId String?            @db.Uuid // null after delete; snapshot lives in before/after
  action    PaymentAuditAction
  byUserId  String             @db.Uuid
  before    Json?
  after     Json?
  createdAt DateTime           @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  byUser  User    @relation(fields: [byUserId], references: [id])

  @@index([invoiceId])
}

// ── Calendar ─────────────────────────────────────────────────────────────────

model Meeting {
  id              String    @id @default(uuid()) @db.Uuid
  title           String
  clientId        String?   @db.Uuid // client OR lead OR internal (both null)
  leadId          String?   @db.Uuid
  /// WHO at the client, when it is worth saying. An optional refinement of `clientId` and never a
  /// replacement for it: the meeting still belongs to the client, so the rollups are untouched,
  /// and SetNull means a contact who leaves takes nothing with them (user, 2026-08-28).
  personId        String?   @db.Uuid
  serviceId       String?   @db.Uuid
  startAt         DateTime
  durationMinutes Int
  link            String? // video-call URL, or a dial-in — free text on purpose
  description     String?
  /// the organiser: who booked it. Null only for rows that predate the field.
  createdById     String?   @db.Uuid
  /// the task opened alongside the meeting, when one was asked for (S8). SetNull, not Cascade:
  /// deleting the task must not take the meeting's record of what was agreed with it.
  taskId          String?   @unique @db.Uuid
  cancelledAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  client       Client?              @relation(fields: [clientId], references: [id])
  lead         Lead?                @relation(fields: [leadId], references: [id])
  person       ClientPerson?        @relation(fields: [personId], references: [id], onDelete: SetNull)
  service      Service?             @relation(fields: [serviceId], references: [id])
  createdBy    User?                @relation("MeetingCreatedBy", fields: [createdById], references: [id])
  task         Task?                @relation(fields: [taskId], references: [id], onDelete: SetNull)
  participants MeetingParticipant[]

  @@index([startAt])
  // the calendar's read: "live meetings in this window, in order"
  @@index([cancelledAt, startAt])
  // without it, deleting one contact seq-scans Meeting to find the rows to null out
  @@index([personId])
}

model MeetingParticipant {
  meetingId String @db.Uuid
  userId    String @db.Uuid

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([meetingId, userId])
  // the conflict check asks "which meetings is THIS PERSON in" — the composite primary key is
  // ordered (meetingId, userId), so it cannot answer that without a scan
  @@index([userId])
}

// ── Notifications ────────────────────────────────────────────────────────────

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  kind      NotificationKind
  text      String
  sub       String?
  linkType  String? // e.g. "task" | "meeting" | "invoice"
  linkId    String?          @db.Uuid
  dedupKey  String? // scheduler triggers: no re-notify on re-scan
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupKey])
  @@index([userId, read])
}

// ── Mailouts ─────────────────────────────────────────────────────────────────

/**
 * A reusable letter. `subject` and `body` carry `{{merge_vars}}` resolved per recipient by
 * shared/mailouts.ts — the SAME renderer the browser preview calls, so what the firm proofreads is
 * character-for-character what leaves the building.
 * Only the subject, the heading and the body vary. The surrounding brand shell (logo, contact
 * block, footer) lives in server/core/email-layout.ts and is not editable here — that is the whole
 * point of "однаково з вигляду, змінюємо лише заголовок".
 */
model EmailTemplate {
  id              String      @id @default(uuid()) @db.Uuid
  name            String      @unique
  subject         String
  /**
   * the heading drawn above the body, `{{vars}}` allowed; falls back to the subject when null
   */
  heading         String?
  body            String
  kind            MailoutKind @default(commercial)
  active          Boolean     @default(true)
  /**
   * which mailbox this template usually goes from; null = the default account
   */
  senderAccountId String?     @db.Uuid
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  senderAccount MailSenderAccount? @relation(fields: [senderAccountId], references: [id])
  mailouts      Mailout[]
  campaigns     Campaign[]
}

/**
 * One act of sending — to a single client or to a hundred.
 * `subject`/`heading`/`body` are a SNAPSHOT taken at send time, still holding their `{{vars}}`.
 * Editing the template afterwards must not rewrite history, and re-rendering per recipient is what
 * lets the log show each person the exact letter they got.
 */
model Mailout {
  id              String      @id @default(uuid()) @db.Uuid
  /**
   * null = a one-off personal letter, written straight into the composer
   */
  templateId      String?     @db.Uuid
  subject         String
  heading         String?
  body            String
  kind            MailoutKind
  /**
   * the mailbox it actually went from — a record, so the log can answer "sent from where"
   */
  senderAccountId String?     @db.Uuid
  /**
   * null = somebody pressed Send. Otherwise the campaign whose date came round.
   */
  campaignId      String?     @db.Uuid
  /**
   * Which of that campaign's dates this run is for — "2026-09-01".
   * The whole reason a missed date is safe: the sweep runs daily AND on every boot, so without a
   * key naming the occurrence, a server that was down over the weekend would re-send on Monday and
   * again on Tuesday. Null for a hand-pressed send, which has no occurrence.
   */
  periodKey       String?
  /**
   * null for a campaign run — nobody pressed anything
   */
  createdById     String?     @db.Uuid
  createdAt       DateTime    @default(now())

  senderAccount MailSenderAccount?     @relation(fields: [senderAccountId], references: [id])
  template      EmailTemplate?         @relation(fields: [templateId], references: [id])
  campaign      Campaign?              @relation(fields: [campaignId], references: [id])
  createdBy     User?                  @relation("MailoutCreatedBy", fields: [createdById], references: [id])
  recipients    MailoutRecipient[]
  /**
   * clients whose opt-out was traced back to this letter — see ClientMailPreference
   */
  unsubscribes  ClientMailPreference[] @relation("UnsubscribedFrom")

  // One run per occurrence, enforced by the database rather than by the sweep being careful.
  // Hand-pressed sends are all (null, null) — and Postgres treats every NULL as distinct, so they
  // never collide with each other, which is exactly what is wanted here.
  @@unique([campaignId, periodKey])
  @@index([createdAt])
}

/// A planned mailout: a template, a list, and a date it goes out on — possibly again and again.
///
/// Deliberately NOT an audience rule ("everyone with service X"). The firm names who, the list is
/// theirs to edit until it fires, and every run writes an ordinary Mailout — so the Sent log stays
/// the single record of what actually left the building, whether a person pressed send or a date
/// came round.
model Campaign {
  id              String         @id @default(uuid()) @db.Uuid
  /**
   * what the firm calls it — "Tax season reminder", not the letter's subject
   */
  name            String
  /**
   * a campaign always sends a saved template; a one-off letter is what the composer is for
   */
  templateId      String         @db.Uuid
  senderAccountId String?        @db.Uuid
  /**
   * Copied from the template when the campaign is made, then owned here.
   * `commercial` is the default and carries unsubscribe + the firm's postal address, and honours
   * an opt-out. `transactional` is a deliberate choice: it reaches clients who unsubscribed and
   * carries no unsubscribe link, which is lawful for a bill or a document request and unlawful
   * for news. The editor warns before letting it be chosen.
   */
  kind            MailoutKind    @default(commercial)
  rhythm          CampaignRhythm @default(once)
  /**
   * the first date it fires; for a rhythm, also the anchor day of the month
   */
  startsOn        DateTime       @db.Date
  /**
   * firm-local time of day, "HH:MM" — the sweep runs daily, this decides which side of it
   */
  sendAt          String         @default("09:00")
  /**
   * a rhythm's last allowed date; null = until somebody stops it
   */
  endsOn          DateTime?      @db.Date
  status          CampaignStatus @default(scheduled)
  /**
   * the next date due. Null once nothing is due — finished, or stopped by hand.
   */
  nextRunOn       DateTime?      @db.Date
  lastRunAt       DateTime?
  createdById     String?        @db.Uuid
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  template      EmailTemplate       @relation(fields: [templateId], references: [id])
  senderAccount MailSenderAccount?  @relation(fields: [senderAccountId], references: [id])
  createdBy     User?               @relation("CampaignCreatedBy", fields: [createdById], references: [id])
  recipients    CampaignRecipient[]
  dates         CampaignDate[]
  runs          Mailout[]

  // the sweep's only query: what is due today
  @@index([status, nextRunOn])
}

/// One day a `dates` campaign goes out on.
///
/// Deliberately stateless — no "sent" flag. Which day already fired is already recorded by
/// `Mailout.periodKey`, and `UNIQUE(campaignId, periodKey)` is what stops a second run. A flag
/// here would be a second answer to the same question, and the two would eventually disagree.
model CampaignDate {
  id         String   @id @default(uuid()) @db.Uuid
  campaignId String   @db.Uuid
  /// the calendar day, stored as UTC midnight like every other business date
  on         DateTime @db.Date
  createdAt  DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, on])
  @@index([campaignId])
}

/// One addressee on a campaign's list — the same client-or-company pair a send takes.
model CampaignRecipient {
  id         String   @id @default(uuid()) @db.Uuid
  campaignId String   @db.Uuid
  clientId   String   @db.Uuid
  /**
   * null = the client's own address; otherwise one of that client's companies
   */
  companyId  String?  @db.Uuid
  createdAt  DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  client   Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  // Cascade, unlike the sent letters' RESTRICT: this is a plan, not a record. Deleting a company
  // that is merely queued up to be written to should quietly drop it from the list, not refuse.
  company  Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Same two-index shape as MailoutRecipient, for the same reason: Postgres treats NULLs as
  // distinct, so this cannot stop the client's own address appearing twice — a partial index in
  // the migration says that half.
  @@unique([campaignId, clientId, companyId])
  @@index([clientId])
  @@index([companyId])
}

/**
 * One client's copy of one send. `email` is a snapshot: the address it actually went to, so a later
 * change on the client card cannot rewrite what the log says happened.
 */
/**
 * One address this letter went to.
 * A recipient is a client OR one of that client's companies — `companyId` null means the client
 * themselves. A firm's client can hold several companies, each with its own inbox, and "send to
 * the client" and "send to Kvitka Trade LLC" are different acts with different addresses.
 * Consent stays on the CLIENT, deliberately: unsubscribing is a person saying "stop marketing to
 * me", and honouring it for their personal address while still mailing their company's would be
 * obeying the letter of the request and not the request.
 */
model MailoutRecipient {
  id        String        @id @default(uuid()) @db.Uuid
  mailoutId String        @db.Uuid
  clientId  String        @db.Uuid
  /**
   * null = the client's own address; otherwise the company whose inbox this went to
   */
  companyId String?       @db.Uuid
  email     String
  status    MailoutStatus @default(queued)
  /**
   * why it was skipped or how it failed — "no email address", "missing {{company}}", SMTP error
   */
  reason    String?
  /**
   * The `Message-ID` this letter went out with, as nodemailer reports it.
   * A bounce quotes it back in `References:`, so it is how a returned letter is matched to the row
   * that sent it — exactly, without guessing from the address. It was being discarded; storing it
   * costs one column and is what makes reading bounces possible at all.
   */
  messageId String?
  sentAt    DateTime?

  /**
   * when a delivery report came back for this letter
   */
  bouncedAt  DateTime?
  /**
   * the enhanced code where the server gave one, else the bare three-digit reply
   */
  bounceCode String?
  bounceKind BounceKind?
  createdAt  DateTime    @default(now())

  mailout Mailout  @relation(fields: [mailoutId], references: [id], onDelete: Cascade)
  client  Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  // RESTRICT, like the billing provenance FKs and for the same reason: "we wrote to this company"
  // is history, and deleting the company must be refused rather than quietly erasing the letters.
  // The clients module turns that refusal into a sentence naming the count.
  company Company? @relation(fields: [companyId], references: [id], onDelete: Restrict)

  // Uniqueness needs TWO indexes, because Postgres treats NULLs as distinct: this one stops the
  // same company twice, and a partial index in the migration stops the same client twice.
  @@unique([mailoutId, clientId, companyId])
  @@index([clientId, createdAt])
  @@index([companyId])
}

/**
 * Whether a client accepts COMMERCIAL mail. Absent row = subscribed; the firm never has to
 * back-fill one to start sending.
 * `token` is the unguessable secret in the one-click unsubscribe link — the route it opens is the
 * only unauthenticated write in the app, so it can afford nothing weaker.
 */
/**
 * An address that a receiving server said does not exist.
 * Keyed by the ADDRESS, not hung off a client: a client has several — their own and one per
 * company — and a bounce kills exactly one of them. The same address may also sit on more than one
 * card, and it is dead for all of them or none.
 * Only `BounceKind.address` ever writes here. A refused greeting or a full mailbox must not, or one
 * misconfiguration of our own would spread into a self-inflicted blocklist of real clients.
 */
model DeadEmailAddress {
  /**
   * lower-cased, because a mailbox is not case-sensitive in any way that matters here
   */
  email       String   @id
  code        String
  reason      String
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @updatedAt

  /**
   * set when somebody vouches for the address again; the row is kept as history
   */
  clearedAt   DateTime?
  clearedById String?   @db.Uuid
  clearedBy   User?     @relation(fields: [clearedById], references: [id], onDelete: SetNull)

  @@index([clearedAt])
}

model ClientMailPreference {
  clientId                  String    @id @db.Uuid
  unsubscribedAt            DateTime?
  /**
   * set when the firm unsubscribed them from the card rather than the client clicking the link
   */
  unsubscribedById          String?   @db.Uuid
  /**
   * WHICH letter's link they clicked — so "unsubscribed from the March newsletter" is answerable.
   * The token belongs to the client, not to a letter, so the click alone cannot say where it came
   * from; the letter puts its own id in the link. That makes the id a claim rather than proof, and
   * it is stored only after checking that the mailout really did have a row for this client.
   * SetNull rather than Cascade: losing the provenance is better than losing the opt-out.
   */
  unsubscribedFromMailoutId String?   @db.Uuid
  token                     String    @unique
  updatedAt                 DateTime  @updatedAt

  client           Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  unsubscribedBy   User?    @relation("MailPreferenceUnsubscribedBy", fields: [unsubscribedById], references: [id])
  unsubscribedFrom Mailout? @relation("UnsubscribedFrom", fields: [unsubscribedFromMailoutId], references: [id], onDelete: SetNull)
}

// ── Files ────────────────────────────────────────────────────────────────────

model File {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  size         Int // bytes, ≤ 25 MB enforced in service
  mime         String
  path         String // relative path on the uploads volume
  clientId     String?  @db.Uuid // client-card files
  uploadedById String   @db.Uuid
  createdAt    DateTime @default(now())

  client            Client?      @relation("ClientFiles", fields: [clientId], references: [id], onDelete: Cascade)
  uploadedBy        User         @relation("FileUploadedBy", fields: [uploadedById], references: [id])
  avatarOfUser      User?        @relation("UserAvatar")
  logoOfProfile     FirmProfile? @relation("FirmLogo")
  mailLogoOfProfile FirmProfile? @relation("FirmMailLogo")

  @@index([clientId])
}
