{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "TheCrmKeyStoresFiles",
      "Effect": "Allow",
      "Principal": { "AWS": ["arn:aws:iam:::user/p<APP_PROJECT>:<APP_KEY_ID>"] },
      "Action": ["s3:ListBucket", "s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": ["arn:aws:s3:::<BUCKET>", "arn:aws:s3:::<BUCKET>/*"]
    },
    {
      "Sid": "TheBackupKeyOnlyReads",
      "Effect": "Allow",
      "Principal": { "AWS": ["arn:aws:iam:::user/p<BACKUP_PROJECT>:<BACKUP_KEY_ID>"] },
      "Action": ["s3:ListBucket", "s3:GetObject", "s3:GetBucketVersioning"],
      "Resource": ["arn:aws:s3:::<BUCKET>", "arn:aws:s3:::<BUCKET>/*"]
    },
    {
      "Sid": "NeitherKeyDestroysHistoryOrChangesTheRules",
      "Effect": "Deny",
      "Principal": {
        "AWS": [
          "arn:aws:iam:::user/p<APP_PROJECT>:<APP_KEY_ID>",
          "arn:aws:iam:::user/p<BACKUP_PROJECT>:<BACKUP_KEY_ID>"
        ]
      },
      "Action": [
        "s3:DeleteObjectVersion",
        "s3:PutBucketPolicy",
        "s3:DeleteBucketPolicy",
        "s3:PutLifecycleConfiguration",
        "s3:PutBucketVersioning",
        "s3:DeleteBucket",
        "s3:PutBucketAcl",
        "s3:PutObjectAcl",
        "s3:PutObjectVersionAcl"
      ],
      "Resource": ["arn:aws:s3:::<BUCKET>", "arn:aws:s3:::<BUCKET>/*"]
    },
    {
      "Sid": "TheBackupKeyNeverWritesNorReadsOldVersions",
      "Effect": "Deny",
      "Principal": { "AWS": ["arn:aws:iam:::user/p<BACKUP_PROJECT>:<BACKUP_KEY_ID>"] },
      "Action": [
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:GetObjectVersion",
        "s3:ListBucketVersions",
        "s3:AbortMultipartUpload"
      ],
      "Resource": ["arn:aws:s3:::<BUCKET>", "arn:aws:s3:::<BUCKET>/*"]
    },
    {
      "Sid": "NorUploadAnythingPublic",
      "Effect": "Deny",
      "Principal": { "AWS": ["arn:aws:iam:::user/p<APP_PROJECT>:<APP_KEY_ID>"] },
      "Action": ["s3:PutObject"],
      "Resource": ["arn:aws:s3:::<BUCKET>/*"],
      "Condition": {
        "StringEquals": {
          "s3:x-amz-acl": ["public-read", "public-read-write", "authenticated-read"]
        }
      }
    }
  ]
}
