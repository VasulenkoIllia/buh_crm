# The backup's environment, 0600 — /etc/buh_crm/backup.env on a server set up as root, or
# ~/.config/buh_crm/backup.env for `install.sh --user`, which rewrites the two paths below to match.
#
# Everything that names the storage lives here and nowhere in the repository, which is public.
# NEVER copy any of it into the project's .env: the app must never hold a key that reaches the
# backups, and the backups must never hold the app's SECRETS_KEY.

# The encrypted repository: the backups bucket, under restic/.
RESTIC_REPOSITORY=s3:https://<location>.your-objectstorage.com/<backups-bucket>/restic
RESTIC_PASSWORD_FILE=/etc/buh_crm/restic.pass

# The backup key — minted in its own project, let in by the bucket's policy. Not the key of the
# project that holds the bucket: that project keeps no key at all.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=<location>

# rclone reads the bucket's versioning with the same key, as the remote "store".
RCLONE_CONFIG_STORE_TYPE=s3
RCLONE_CONFIG_STORE_PROVIDER=Other
RCLONE_CONFIG_STORE_ENV_AUTH=true
RCLONE_CONFIG_STORE_ENDPOINT=https://<location>.your-objectstorage.com
RCLONE_CONFIG_STORE_REGION=<location>

# The files bucket, mirrored every night after the dump and backed up with it (backups.md §7.9).
# Off until the client files have moved into the bucket: uncomment the six lines then. The same key
# reads it — the files bucket's policy lets the backup key list and read, and nothing more.
# BACKUP_FILES_REMOTE=files:<files-bucket>
# RCLONE_CONFIG_FILES_TYPE=s3
# RCLONE_CONFIG_FILES_PROVIDER=Other
# RCLONE_CONFIG_FILES_ENV_AUTH=true
# RCLONE_CONFIG_FILES_ENDPOINT=https://<files-location>.your-objectstorage.com
# RCLONE_CONFIG_FILES_REGION=<files-location>
# At most this many files deleted from the mirror in one night; one more stops it, and the night is
# red. At least three nights of the purge's 300 (files.md §9), so ordinary disposal never trips it.
# BACKUP_FILES_MAX_DELETE=1000

# Optional: a URL pinged after every good night and every passed restore test. A free "dead man's
# switch" service emails when a ping does not arrive — the one alarm that works when the whole
# server is down.
# BACKUP_PING_URL=
# BACKUP_DRILL_PING_URL=

# Everything below has a production default; set it only on a laptop. Absolute paths.
# BACKUP_STATE_DIR=/var/lib/buh_crm
# BACKUP_UPLOADS_DIR=<the project directory>/data/uploads
# BACKUP_DB_CONTAINER=buh_crm-db
