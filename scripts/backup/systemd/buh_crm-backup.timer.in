[Unit]
Description=buh_crm nightly backup at 02:00, firm time

[Timer]
# The zone is the timer's own, so the host's clock — shared with other projects — is left alone.
OnCalendar=*-*-* 02:00:00 @TZ@
# A night missed because the server was off runs as soon as it is back.
Persistent=true

[Install]
WantedBy=timers.target
